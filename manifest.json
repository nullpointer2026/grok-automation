{
  "manifest_version": 3,
  "name": "Grok Automation",
  "version": "1.0.2",
  "description": "在 grok.com 批量自动化生成视频和图片",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://*.grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Grok Automation"
  }
}
